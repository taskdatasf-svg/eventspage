generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  profileImage String?
  createdAt    DateTime @default(now())
}

model Event {
  id              String   @id @default(cuid())
  ticketCode      String
  title           String
  organizer       String?  @default("Infinity Event Organizer")
  location        String?
  description     String?
  startDate       String
  startTime       String
  endDate         String?
  endTime         String?
  price           String   @default("Free")
  requireApproval Boolean  @default(false)
  capacity        String   @default("Unlimited")
  calendarType    String   @default("Personal Calendar")
  visibility      String   @default("Public")
  coverImage      String?
  themeIdx        Int      @default(0)
  headerBg        String   @default("bg-[#818cf8]")
  font            String?  @default("Default")
  customFields    String?
  speakers        String?
  createdAt       DateTime @default(now())
}

model Registration {
  id                 String   @id @default(cuid())
  eventId            String
  eventTitle         String
  name               String
  email              String
  phone              String?
  ticketCode         String   @unique
  answers            String?
  paymentAccountName String?
  paymentMethod      String?
  paymentTxnId       String?
  couponCode         String?
  discountApplied    Float?   @default(0)
  status             String   @default("APPROVED")
  attended           Boolean? @default(false)
  createdAt          DateTime @default(now())
}


model SupportQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  eventId        String?
  eventTitle     String?
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED_AMOUNT"
  discountValue  Float     // e.g. 50 (for 50%) or 100 (for ₹100 flat off)
  maxUses        Int?      // null = unlimited
  usedCount      Int       @default(0)
  minOrderAmount Float?    @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  organizerEmail String?
  createdAt      DateTime  @default(now())
}


